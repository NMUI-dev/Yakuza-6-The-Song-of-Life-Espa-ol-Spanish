},
{
"id": 22995,
"en": "Oh, Kiryu-chi!",
"ctx": "sound_auth|table/#//# + sound_auth_subtitles_speech_list_sub_a14|#",
"max": null
},
{
"id": 22996,
"en": "You need somethin'? <font_kind=yakuza_italic>Whoaaa</font_kind>!\nHow long has Paul Lim been here!?",
