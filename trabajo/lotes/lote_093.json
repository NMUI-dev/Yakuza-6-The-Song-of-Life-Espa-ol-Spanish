"max": null
},
{
"id": 23076,
"en": "Saki-san!?",
"ctx": "sound_auth|table/#//# + sound_auth_subtitles_speech_list_sub_a15|#",
"max": null
},
{
"id": 23077,
"en": "Are you okay?\nYou're not hurt?",
