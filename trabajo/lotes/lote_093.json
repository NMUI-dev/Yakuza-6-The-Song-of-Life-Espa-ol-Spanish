"max": null
},
{
"id": 23035,
"en": "[Oh, okay!]",
"ctx": "sound_auth|table/#//# + sound_auth_subtitles_speech_list_sub_a14|#",
"max": null
},
{
"id": 23036,
"en": "[Well then, Kiryu-san.\nI hope we get to enjoy another game.]",
