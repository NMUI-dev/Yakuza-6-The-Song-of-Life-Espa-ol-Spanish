"max": null
},
{
"id": 23067,
"en": "You just made it my concern.",
"ctx": "sound_auth|table/#//# + sound_auth_subtitles_speech_list_sub_a15|#",
"max": null
},
{
"id": 23068,
"en": "This guy here... is a big fan of\nsomeone pretty special to me.",
"ctx": "sound_auth|table/#//# + sound_auth_subtitles_speech_list_sub_a15|#",
"max": null
},
{
"id": 23069,
"en": "What the fuck...!?\nFuck it, let's get this guy's cash!",
"ctx": "sound_auth|table/#//# + sound_auth_subtitles_speech_list_sub_a15|#",
"max": null
},
{
