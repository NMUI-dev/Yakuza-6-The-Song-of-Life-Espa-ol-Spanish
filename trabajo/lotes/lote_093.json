},
{
"id": 23045,
"en": "Sure!",
"ctx": "sound_auth|table/#//# + sound_auth_subtitles_speech_list_sub_a15|# + sound_auth_subtitles_speech_list_sub_b18|#",
"max": null
},
{
"id": 23046,
"en": "Hm? What's up?",
"ctx": "sound_auth|table/#//# + sound_auth_subtitles_speech_list_sub_a15|#",
"max": null
},
{
"id": 23047,
"en": "That boy there, I recognize him.\nHe's always cheering for me at my matches.",
