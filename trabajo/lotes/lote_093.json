"max": null
},
{
"id": 22993,
"en": "Huh? Sorry, I don't speak English.",
"ctx": "sound_auth|table/#//# + sound_auth_subtitles_speech_list_sub_a14|#",
"max": null
},
{
"id": 22994,
"en": "Hey, Akaishizawa!\nGet over here.",
