"en": "Whoaaa, this is crazy!\nI wanna see who wins that battle!",
"ctx": "sound_auth|table/#//# + sound_auth_subtitles_speech_list_sub_a14|#",
"max": null
},
{
"id": 23009,
"en": "Paul-chi said he wants to go\n<font_kind=yakuza_italic>mano a mano</font_kind> with you, Kiryu-chi!",
"ctx": "sound_auth|table/#//# + sound_auth_subtitles_speech_list_sub_a14|#",
"max": null
},
{
