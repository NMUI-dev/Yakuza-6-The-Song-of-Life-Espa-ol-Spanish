},
{
"id": 23025,
"en": "[Oh my god!]",
"ctx": "sound_auth|table/#//# + sound_auth_subtitles_speech_list_sub_a14|#",
"max": null
},
{
"id": 23026,
"en": "Duuude, this is amazin'!\nYou beat the one and only Paul Lim!",
"ctx": "sound_auth|table/#//# + sound_auth_subtitles_speech_list_sub_a14|#",
"max": null
},
{
