"max": null
},
{
"id": 22998,
"en": "Gotcha. That's why ya need me, huh?",
"ctx": "sound_auth|table/#//# + sound_auth_subtitles_speech_list_sub_a14|#",
"max": null
},
{
"id": 22999,
"en": "All right, Paul.\nI'm ready to hear you out now.",
"ctx": "sound_auth|table/#//# + sound_auth_subtitles_speech_list_sub_a14|#",
"max": null
},
{
"id": 23000,
"en": "[I've heard a lot about you lately, Kiryu-san.]",
"ctx": "sound_auth|table/#//# + sound_auth_subtitles_speech_list_sub_a14|#",
"max": null
},
{
"id": 23001,
"en": "[It seems you have become\nthe best darts player in town.]",
"ctx": "sound_auth|table/#//# + sound_auth_subtitles_speech_list_sub_a14|#",
"max": null
},
{
"id": 23002,
"en": "Uh-huh, uh-huh.",
"ctx": "sound_auth|table/#//# + sound_auth_subtitles_speech_list_sub_a14|#",
"max": null
},
{
"id": 23003,
"en": "He said you're unstoppable force, Kiryu-chi.\nThe best dart slinger this side o' the Millennium Tower.",
"ctx": "sound_auth|table/#//# + sound_auth_subtitles_speech_list_sub_a14|#",
"max": null
},
{
"id": 23004,
"en": "He said you're gettin' famous, Kiryu-chi.\nYou're the best slinger this side o' the Millennium Tower.",
"ctx": "sound_auth|table/#//# + sound_auth_subtitles_speech_list_sub_a14|#",
"max": null
},
{
"id": 23005,
"en": "Hm...\nWell, I <font_kind=yakuza_italic>have</font_kind> practiced a lot.",
"ctx": "sound_auth|table/#//# + sound_auth_subtitles_speech_list_sub_a14|#",
"max": null
},
{
"id": 23006,
"en": "[I think we could have\na pretty good match, Kiryu-san.]",
"ctx": "sound_auth|table/#//# + sound_auth_subtitles_speech_list_sub_a14|#",
"max": null
},
{
"id": 23007,
"en": "[Would you like to play against me?]",
"ctx": "sound_auth|table/#//# + sound_auth_subtitles_speech_list_sub_a14|#",
"max": null
},
{
