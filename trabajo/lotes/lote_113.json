"max": null
},
{
"id": 27399,
"en": "How did he get my email address...?",
"ctx": "sound_auth|table/#//# + sound_auth_subtitles_speech_list_sub_b26|#",
"max": null
},
{
"id": 27400,
"en": "Whatever. I'll try to go wherever\nhe's waiting when I find the time...",
"ctx": "sound_auth|table/#//# + sound_auth_subtitles_speech_list_sub_b26|#",
"max": null
},
{
"id": 27401,
"en": "Oh, there you are, Kiryu-kun.",
"ctx": "sound_auth|table/#//# + sound_auth_subtitles_speech_list_sub_b26|#",
"max": null
},
{
"id": 27402,
"en": "What do you want now...?",
"ctx": "sound_auth|table/#//# + sound_auth_subtitles_speech_list_sub_b26|#",
"max": null
},
{
