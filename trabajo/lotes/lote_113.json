"en": "Dieeeee, Kazuma Kiryuuuuuu!",
"ctx": "sound_auth|table/#//# + sound_auth_subtitles_speech_list_sub_b26|#",
"max": null
},
{
"id": 27410,
"en": "Shit... I underestimated you...",
"ctx": "sound_auth|table/#//# + sound_auth_subtitles_speech_list_sub_b26|#",
"max": null
},
{
"id": 27411,
"en": "What happened, Kiryu-kun?\nYou're not your usual self.",
