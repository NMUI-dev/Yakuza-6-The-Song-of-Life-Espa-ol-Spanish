"ctx": "sound_auth|table/#//# + sound_auth_subtitles_speech_list_sub_b26|#",
"max": null
},
{
"id": 27355,
"en": "Don't you think that's an\nincredibly worthwhile cause?",
"ctx": "sound_auth|table/#//# + sound_auth_subtitles_speech_list_sub_b26|#",
"max": null
},
{
"id": 27356,
"en": "Not really.",
"ctx": "sound_auth|table/#//# + sound_auth_subtitles_speech_list_sub_b26|# + talk",
"max": 15
},
{
"id": 27357,
"en": "I don't get you at all...",
"ctx": "sound_auth|table/#//# + sound_auth_subtitles_speech_list_sub_b26|#",
"max": null
},
{
"id": 27358,
"en": "Fine! Then I'll force you to help me!",
"ctx": "sound_auth|table/#//# + sound_auth_subtitles_speech_list_sub_b26|#",
"max": null
},
{
"id": 27359,
"en": "What? Whoa, hold on...",
"ctx": "sound_auth|table/#//# + sound_auth_subtitles_speech_list_sub_b26|#",
"max": null
},
{
"id": 27360,
"en": "You're too naive, Kiryu-kun!",
"ctx": "sound_auth|table/#//# + sound_auth_subtitles_speech_list_sub_b26|#",
"max": null
},
{
