[
{
"id": 17146,
"en": "Cap, we need to help Matsunaga-aniki!",
"ctx": "sound_auth|table/#//# + sound_auth_subtitles_speech_list_main04|#",
"max": null
},
{
"id": 17147,
"en": "I said, I ain't gonna go.\nOh, by the way, Tagashira...",
"ctx": "sound_auth|table/#//# + sound_auth_subtitles_speech_list_main04|#",
"max": null
},
{
"id": 17148,
"en": "This guy's my new aniki, Kiryu-san.\nY'better treat him like family.",
"ctx": "sound_auth|table/#//# + sound_auth_subtitles_speech_list_main04|#",
"max": null
},
{
"id": 17149,
"en": "Then screw it!",
"ctx": "sound_auth|table/#//# + sound_auth_subtitles_speech_list_main04|#",
"max": null
},
{
"id": 17150,
"en": "We'll have'ta save 'im jus' the two of us!\nC'mon, Yuta!",
"ctx": "sound_auth|table/#//# + sound_auth_subtitles_speech_list_main04|#",
"max": null
},
{
"id": 17151,
"en": "Coming!",
"ctx": "sound_auth|table/#//# + sound_auth_subtitles_speech_list_main04|#",
"max": null
},
{
"id": 17152,
"en": "Sheesh. Sorry 'bout that, Aniki.",
"ctx": "sound_auth|table/#//# + sound_auth_subtitles_speech_list_main04|#",
"max": null
},
{
"id": 17153,
"en": "They don't got a lick of sense\nwhen it comes t'manners.",
"ctx": "sound_auth|table/#//# + sound_auth_subtitles_speech_list_main04|#",
"max": null
},
{
"id": 17154,
"en": "You're gonna let them go?",
"ctx": "sound_auth|table/#//# + sound_auth_subtitles_speech_list_main04|#",
"max": null
},
{
"id": 17155,
"en": "The younger guy had a knife on him.",
"ctx": "sound_auth|table/#//# + sound_auth_subtitles_speech_list_main04|#",
"max": null
},
{
"id": 17156,
"en": "Yeah, it's all good.",
"ctx": "sound_auth|table/#//# + sound_auth_subtitles_speech_list_main04|#",
"max": null
},
{
"id": 17157,
"en": "Y'remember Matsunaga, right?",
"ctx": "sound_auth|table/#//# + sound_auth_subtitles_speech_list_main04|#",
"max": null
},
{
"id": 17158,
"en": "He was over with me n' Yuta\nwhen we were playin' baseball.",
"ctx": "sound_auth|table/#//# + sound_auth_subtitles_speech_list_main04|#",
"max": null
},
{
"id": 17159,
"en": "Right, I remember fighting three of you.",
"ctx": "sound_auth|table/#//# + sound_auth_subtitles_speech_list_main04|#",
"max": null
},
{
"id": 17160,
"en": "Well, Matsunaga's been runnin'\na bar called Moreno fer a while now.",
"ctx": "sound_auth|table/#//# + sound_auth_subtitles_speech_list_main04|#",
"max": null
},
{
"id": 17161,
"en": "He's always gettin' uppity at his customers.",
"ctx": "sound_auth|table/#//# + sound_auth_subtitles_speech_list_main04|#",
"max": null
},
{
"id": 17162,
"en": "This shit happens jus' about every day.",
"ctx": "sound_auth|table/#//# + sound_auth_subtitles_speech_list_main04|#",
"max": null
},
{
"id": 17163,
"en": "Is this Moreno near here?",
"ctx": "sound_auth|table/#//# + sound_auth_subtitles_speech_list_main04|#",
"max": null
},
{
"id": 17164,
"en": "Huh? Yeah...",
"ctx": "sound_auth|table/#//# + sound_auth_subtitles_speech_list_main04|#",
"max": null
},
{
"id": 17165,
"en": "It's 'cross the bar district,\njust a hair in front o' the arcade.",
"ctx": "sound_auth|table/#//# + sound_auth_subtitles_speech_list_main04|#",
"max": null
},
{
"id": 17166,
"en": "By the way, Aniki...\nI'm the captain o' this family.",
"ctx": "sound_auth|table/#//# + sound_auth_subtitles_speech_list_main04|#",
"max": null
},
{
"id": 17167,
"en": "I'll keep everyone in line, y'hear?",
"ctx": "sound_auth|table/#//# + sound_auth_subtitles_speech_list_main04|#",
"max": null
},
{
"id": 17168,
"en": "Oh, and think o' this place\nas yer home, Aniki. It ain't so bad.",
"ctx": "sound_auth|table/#//# + sound_auth_subtitles_speech_list_main04|#",
"max": null
},
{
"id": 17169,
"en": "If yer includin' me n' Hirose-san, there're\nonly five o' us in the whole family.",
"ctx": "sound_auth|table/#//# + sound_auth_subtitles_speech_list_main04|#",
"max": null
},
{
"id": 17170,
"en": "Y'can relax here whenever y'want.",
"ctx": "sound_auth|table/#//# + sound_auth_subtitles_speech_list_main04|#",
"max": null
},
{
"id": 17171,
"en": "Aniki? Where're y'goin'?",
"ctx": "sound_auth|table/#//# + sound_auth_subtitles_speech_list_main04|#",
"max": null
},
{
"id": 17172,
"en": "(So this is Moreno.\nMatsunaga should be in here...)",
"ctx": "sound_auth|table/#//# + sound_auth_subtitles_speech_list_main04|#",
"max": null
},
{
"id": 17173,
"en": "Wh-Who is this guy...?",
"ctx": "sound_auth|table/#//# + sound_auth_subtitles_speech_list_main04|#",
"max": null
},
{
"id": 17174,
"en": "Man, that's Kiryu-aniki fer ya!\nIncredible. Y'really showed 'em!",
"ctx": "sound_auth|table/#//# + sound_auth_subtitles_speech_list_main04|#",
"max": null
},
{
"id": 17175,
"en": "You're a little late, Nagumo.",
"ctx": "sound_auth|table/#//# + sound_auth_subtitles_speech_list_main04|#",
"max": null
},
{
"id": 17176,
"en": "Well, I can't go 'round beatin' up\nour payin' customers.",
"ctx": "sound_auth|table/#//# + sound_auth_subtitles_speech_list_main04|#",
"max": null
},
{
"id": 17177,
"en": "Sorry fer not helpin'.",
"ctx": "sound_auth|table/#//# + sound_auth_subtitles_speech_list_main04|#",
"max": null
},
{
"id": 17178,
"en": "Hey, Matsunaga.\nY'doin' okay?",
"ctx": "sound_auth|table/#//# + sound_auth_subtitles_speech_list_main04|#",
"max": null
},
{
"id": 17179,
"en": "I was worried about ya, y'know?\nDon't that make ya happy?",
"ctx": "sound_auth|table/#//# + sound_auth_subtitles_speech_list_main04|#",
"max": null
},
{
"id": 17180,
"en": "Anyway, Kiryu-aniki was real\nnice in drivin' those bastards off.",
"ctx": "sound_auth|table/#//# + sound_auth_subtitles_speech_list_main04|#",
"max": null
},
{
"id": 17181,
"en": "Y'oughta be more grateful.",
"ctx": "sound_auth|table/#//# + sound_auth_subtitles_speech_list_main04|#",
"max": null
},
{
"id": 17182,
"en": "K... Kiryu?",
"ctx": "sound_auth|table/#//# + sound_auth_subtitles_speech_list_main04|#",
"max": null
},
{
"id": 17183,
"en": "Yer that guy from the baseball game!",
"ctx": "sound_auth|table/#//# + sound_auth_subtitles_speech_list_main04|#",
"max": null
},
{
"id": 17184,
"en": "Forget about all that, Matsunaga.\nKiryu here's my aniki now.",
"ctx": "sound_auth|table/#//# + sound_auth_subtitles_speech_list_main04|#",
"max": null
},
{
"id": 17185,
"en": "He's gonna be hanging 'round our\noffice now n' again, too.",
"ctx": "sound_auth|table/#//# + sound_auth_subtitles_speech_list_main04|#",
"max": null
},
{
"id": 17186,
"en": "Y'best be givin' him the respect\nhe deserves, y'hear?",
"ctx": "sound_auth|table/#//# + sound_auth_subtitles_speech_list_main04|#",
"max": null
},
{
"id": 17187,
"en": "What're y'sayin', Cap!?",
"ctx": "sound_auth|table/#//# + sound_auth_subtitles_speech_list_main04|#",
"max": null
},
{
"id": 17188,
"en": "Y'can't just let him in like this!\nAin't he s'posed to be our enemy?",
"ctx": "sound_auth|table/#//# + sound_auth_subtitles_speech_list_main04|#",
"max": null
},
{
"id": 17189,
"en": "Shut it! Yesterday's enemy is today's aniki.\nGet yer head 'round that.",
"ctx": "sound_auth|table/#//# + sound_auth_subtitles_speech_list_main04|#",
"max": null
},
{
"id": 17190,
"en": "Or are ya sayin' y'can't follow orders?",
"ctx": "sound_auth|table/#//# + sound_auth_subtitles_speech_list_main04|#",
"max": null
},
{
"id": 17191,
"en": "This ain't any ol' order!",
"ctx": "sound_auth|table/#//# + sound_auth_subtitles_speech_list_main04|#",
"max": null
},
{
"id": 17192,
"en": "Jus' today, you picked a fight with\nthis guy. We backed ya up, too!",
"ctx": "sound_auth|table/#//# + sound_auth_subtitles_speech_list_main04|#",
"max": null
},
{
"id": 17193,
"en": "Y'can't change yer mind that easy, Cap.",
"ctx": "sound_auth|table/#//# + sound_auth_subtitles_speech_list_main04|#",
"max": null
},
{
"id": 17194,
"en": "How y'expect us to keep up!?",
"ctx": "sound_auth|table/#//# + sound_auth_subtitles_speech_list_main04|#",
"max": null
},
{
"id": 17195,
"en": "Ya selfish ingrate!",
"ctx": "sound_auth|table/#//# + sound_auth_subtitles_speech_list_main04|#",
"max": null
},
{
"id": 17196,
"en": "Maybe consider who saved\nyer sorry ass jus' now!",
"ctx": "sound_auth|table/#//# + sound_auth_subtitles_speech_list_main04|#",
"max": null
},
{
"id": 17197,
"en": "If it weren't for Kiryu-aniki...",
"ctx": "sound_auth|table/#//# + sound_auth_subtitles_speech_list_main04|#",
"max": null
},
{
"id": 17198,
"en": "...Who knows what kinda shape\nyou'd be in if he hadn't.",
"ctx": "sound_auth|table/#//# + sound_auth_subtitles_speech_list_main04|#",
"max": null
},
{
"id": 17199,
"en": "Clear?",
"ctx": "sound_auth|table/#//# + sound_auth_subtitles_speech_list_main04|#",
"max": null
},
{
"id": 17200,
"en": "This is my bar, y'know.\nY'can't talk to me like that here.",
"ctx": "sound_auth|table/#//# + sound_auth_subtitles_speech_list_main04|#",
"max": null
},
{
"id": 17201,
"en": "It ain't yours.",
"ctx": "sound_auth|table/#//# + sound_auth_subtitles_speech_list_main04|#",
"max": null
},
{
"id": 17202,
"en": "I'm jus' lettin' you run it for me.",
"ctx": "sound_auth|table/#//# + sound_auth_subtitles_speech_list_main04|#",
"max": null
},
{
"id": 17203,
"en": "'Sides...",
"ctx": "sound_auth|table/#//# + sound_auth_subtitles_speech_list_main04|#",
"max": null
},
{
"id": 17204,
"en": "...Weren't those customers\na buncha ship buildin' types?",
"ctx": "sound_auth|table/#//# + sound_auth_subtitles_speech_list_main04|#",
"max": null
},
{
"id": 17205,
"en": "Y'know we can't raise our fists at 'em.",
"ctx": "sound_auth|table/#//# + sound_auth_subtitles_speech_list_main04|#",
"max": null
},
{
"id": 17206,
"en": "They could bring us all down with a\nflick of the wrist if they wanted, right?",
"ctx": "sound_auth|table/#//# + sound_auth_subtitles_speech_list_main04|#",
"max": null
},
{
"id": 17207,
"en": "Ya think y'could face Hirose-san\nif that happened?",
"ctx": "sound_auth|table/#//# + sound_auth_subtitles_speech_list_main04|#",
"max": null
},
{
"id": 17208,
"en": "Wait, Aniki!\nWhere're ya goin'?",
"ctx": "sound_auth|table/#//# + sound_auth_subtitles_speech_list_main04|#",
"max": null
},
{
"id": 17209,
"en": "I haven't finished introducin' ya.",
"ctx": "sound_auth|table/#//# + sound_auth_subtitles_speech_list_main04|#",
"max": null
},
{
"id": 17210,
"en": "I left my baby over at Kiyomi's bar.",
"ctx": "sound_auth|table/#//# + sound_auth_subtitles_speech_list_main04|#",
"max": null
},
{
"id": 17211,
"en": "Sorry, but I've gotta get back.",
"ctx": "sound_auth|table/#//# + sound_auth_subtitles_speech_list_main04|#",
"max": null
},
{
"id": 17212,
"en": "Oh. In that case, can y'cruise on by\nour office tomorrow?",
"ctx": "sound_auth|table/#//# + sound_auth_subtitles_speech_list_main04|#",
"max": null
},
{
"id": 17213,
"en": "I'll be waitin' by the door for ya,\nso come whenever's good.",
"ctx": "sound_auth|table/#//# + sound_auth_subtitles_speech_list_main04|#",
"max": null
},
{
"id": 17214,
"en": "Sure. I'll see you then.",
"ctx": "sound_auth|table/#//# + sound_auth_subtitles_speech_list_main04|#",
"max": null
},
{
"id": 17215,
"en": "Aniki! Thanks fer everythin'!\nStay safe on yer way home!",
"ctx": "sound_auth|table/#//# + sound_auth_subtitles_speech_list_main04|#",
"max": null
},
{
"id": 17216,
"en": "This is kinda pathetic...",
"ctx": "sound_auth|table/#//# + sound_auth_subtitles_speech_list_main04|#",
"max": null
},
{
"id": 17217,
"en": "For real...",
"ctx": "sound_auth|table/#//# + sound_auth_subtitles_speech_list_main04|#",
"max": null
},
{
"id": 17218,
"en": "(It's gotten late. I should go\npick up Haruto from Kiyomi's bar...)",
"ctx": "sound_auth|table/#//# + sound_auth_subtitles_speech_list_main04|#",
"max": null
},
{
"id": 17219,
"en": "Kiryu-san! Are you okay?\nHow's Nagumo-kun?",
"ctx": "sound_auth|table/#//# + sound_auth_subtitles_speech_list_main04|#",
"max": null
},
{
"id": 17220,
"en": "He's doing fine.\nSorry I was gone so long.",
"ctx": "sound_auth|table/#//# + sound_auth_subtitles_speech_list_main04|#",
"max": null
},
{
"id": 17221,
"en": "Don't worry about it. I'm just\nglad you're back in one piece.",
"ctx": "sound_auth|table/#//# + sound_auth_subtitles_speech_list_main04|#",
"max": null
},
{
"id": 17222,
"en": "Sorry again.",
"ctx": "sound_auth|table/#//# + sound_auth_subtitles_speech_list_main04|#",
"max": null
},
{
"id": 17223,
"en": "So, what happened out there?",
"ctx": "sound_auth|table/#//# + sound_auth_subtitles_speech_list_main04|#",
"max": null
},
{
"id": 17224,
"en": "Hold on, Kiryu-san.\nYou're joining the Hirose Family?",
"ctx": "sound_auth|table/#//# + sound_auth_subtitles_speech_list_main04|#",
"max": null
},
{
"id": 17225,
"en": "What gave you that impression?\nThat's not it at all.",
"ctx": "sound_auth|table/#//# + sound_auth_subtitles_speech_list_main04|#",
"max": null
},
{
"id": 17226,
"en": "They just had me over as a guest.\nI'm not joining up.",
"ctx": "sound_auth|table/#//# + sound_auth_subtitles_speech_list_main04|#",
"max": null
},
{
"id": 17227,
"en": "Hm... Honestly, I'm not sure\nI see the difference.",
"ctx": "sound_auth|table/#//# + sound_auth_subtitles_speech_list_main04|#",
"max": null
},
{
"id": 17228,
"en": "But you at least buried the hatchet\nwith Nagumo-kun, right?",
"ctx": "sound_auth|table/#//# + sound_auth_subtitles_speech_list_main04|#",
"max": null
},
{
"id": 17229,
"en": "That's good to hear.",
"ctx": "sound_auth|table/#//# + sound_auth_subtitles_speech_list_main04|# + sound_auth_subtitles_speech_list_sub_a03|#",
"max": null
},
{
"id": 17230,
"en": "You know, he really saw you as\nhis enemy, Kiryu-san.",
"ctx": "sound_auth|table/#//# + sound_auth_subtitles_speech_list_main04|#",
"max": null
},
{
"id": 17231,
"en": "Yeah, I know.",
"ctx": "sound_auth|table/#//# + sound_auth_subtitles_speech_list_main04|#",
"max": null
},
{
"id": 17232,
"en": "Just so you know, I'm heading to\nthe Hirose office again tomorrow.",
"ctx": "sound_auth|table/#//# + sound_auth_subtitles_speech_list_main04|#",
"max": null
},
{
"id": 17233,
"en": "With everything that happened, I never\ngot to ask about Haruka or Haruto's dad.",
"ctx": "sound_auth|table/#//# + sound_auth_subtitles_speech_list_main04|#",
"max": null
},
{
"id": 17234,
"en": "Oh, so that's why you're\nspending time with them?",
"ctx": "sound_auth|table/#//# + sound_auth_subtitles_speech_list_main04|#",
"max": null
},
{
"id": 17235,
"en": "This honestly isn't how\nI expected things to go...",
"ctx": "sound_auth|table/#//# + sound_auth_subtitles_speech_list_main04|#",
"max": null
},
{
"id": 17236,
"en": "...But I guess that's life.",
"ctx": "sound_auth|table/#//# + sound_auth_subtitles_speech_list_main04|#",
"max": null
},
{
"id": 17237,
"en": "Well, we should get going.",
"ctx": "sound_auth|table/#//# + sound_auth_subtitles_speech_list_main04|#",
"max": null
},
{
"id": 17238,
"en": "Of course. Come back anytime.",
"ctx": "sound_auth|table/#//# + sound_auth_subtitles_speech_list_main04|#",
"max": null
},
{
"id": 17239,
"en": "(I should head back to the apartment.\nIt's been a long night...)",
"ctx": "sound_auth|table/#//# + sound_auth_subtitles_speech_list_main04|#",
"max": null
},
{
"id": 17240,
"en": "(I'm exhausted.\nI should probably get to sleep.)",
"ctx": "sound_auth|table/#//# + sound_auth_subtitles_speech_list_main04|#",
"max": null
},
{
"id": 17241,
"en": "(Maybe I'll explore the town\na little longer first.)",
"ctx": "sound_auth|table/#//# + sound_auth_subtitles_speech_list_main04|#",
"max": null
},
{
"id": 17242,
"en": "(All right. Time for bed.)",
"ctx": "sound_auth|table/#//# + sound_auth_subtitles_speech_list_main04|#",
"max": null
},
{
"id": 17243,
"en": "(I should stop by the Hirose Family office.\nSomeone there might recognize Haruka.)",
"ctx": "sound_auth|table/#//# + sound_auth_subtitles_speech_list_main04|#",
"max": null
},
{
"id": 17244,
"en": "Aniki! An honor to have ya back!",
"ctx": "sound_auth|table/#//# + sound_auth_subtitles_speech_list_main04|#",
"max": null
},
{
"id": 17245,
"en": "Good to see you again.",
"ctx": "sound_auth|table/#//# + sound_auth_subtitles_speech_list_main04|#",
"max": null
},
{
"id": 17246,
"en": "Don't give yer guest that half-assed crap!",
"ctx": "sound_auth|table/#//# + sound_auth_subtitles_speech_list_main04|#",
"max": null
},
{
"id": 17247,
"en": "I've been wonderin' something, though.",
"ctx": "sound_auth|table/#//# + sound_auth_subtitles_speech_list_main04|#",
"max": null
},
{
"id": 17248,
"en": "What's the deal with that baby?",
"ctx": "sound_auth|table/#//# + sound_auth_subtitles_speech_list_main04|#",
"max": null
},
{
"id": 17249,
"en": "I'll just say he's not my kid,\nand he's not my grandkid either.",
"ctx": "sound_auth|table/#//# + sound_auth_subtitles_speech_list_main04|#",
"max": null
},
{
"id": 17250,
"en": "Sooo... Y'kidnapped him?",
"ctx": "sound_auth|table/#//# + sound_auth_subtitles_speech_list_main04|#",
"max": null
},
{
"id": 17251,
"en": "'Course he didn't, ya numbnuts!",
"ctx": "sound_auth|table/#//# + sound_auth_subtitles_speech_list_main04|#",
"max": null
},
{
"id": 17252,
"en": "What kinda guy d'ya think Aniki is!?",
"ctx": "sound_auth|table/#//# + sound_auth_subtitles_speech_list_main04|#",
"max": null
},
{
"id": 17253,
"en": "Uh, I can't actually deny that.",
"ctx": "sound_auth|table/#//# + sound_auth_subtitles_speech_list_main04|#",
"max": null
},
{
"id": 17254,
"en": "Anyway, this is Haruto.\nI'm looking for his father.",
"ctx": "sound_auth|table/#//# + sound_auth_subtitles_speech_list_main04|#",
"max": null
},
{
"id": 17255,
"en": "That's what brought me to town.",
"ctx": "sound_auth|table/#//# + sound_auth_subtitles_speech_list_main04|#",
"max": null
},
{
"id": 17256,
"en": "Can ya give us some details?",
"ctx": "sound_auth|table/#//# + sound_auth_subtitles_speech_list_main04|#",
"max": null
},
{
"id": 17257,
"en": "Take a seat first, Aniki.\nY'can tell us all about the kid after.",
"ctx": "sound_auth|table/#//# + sound_auth_subtitles_speech_list_main04|#",
"max": null
},
{
"id": 17258,
"en": "(I should check in with the family patriarch.\nWould be rude not to at least say hello.)",
"ctx": "sound_auth|table/#//# + sound_auth_subtitles_speech_list_main04|#",
"max": null
},
{
"id": 17259,
"en": "Is that our Tokyo man?",
"ctx": "sound_auth|table/#//# + sound_auth_subtitles_speech_list_main04|#",
"max": null
},
{
"id": 17260,
"en": "Yeah. I was in the neighborhood.",
"ctx": "sound_auth|table/#//# + sound_auth_subtitles_speech_list_main04|#",
"max": null
},
{
"id": 17261,
"en": "C'mon in.",
"ctx": "sound_auth|table/#//# + sound_auth_subtitles_speech_list_main04|#",
"max": null
},
{
"id": 17262,
"en": "Hm? And who's this?",
"ctx": "sound_auth|table/#//# + sound_auth_subtitles_speech_list_main04|#",
"max": null
},
{
"id": 17263,
"en": "Hey, Haruto!",
"ctx": "sound_auth|table/#//# + sound_auth_subtitles_speech_list_main04|#",
"max": null
},
{
"id": 17264,
"en": "Don't worry 'bout it.",
"ctx": "sound_auth|table/#//# + sound_auth_subtitles_speech_list_main04|#",
"max": null
},
{
"id": 17265,
"en": "How've you been?",
"ctx": "sound_auth|table/#//# + sound_auth_subtitles_speech_list_main04|#",
"max": null
},
{
"id": 17266,
"en": "My boys givin' ya any trouble?",
"ctx": "sound_auth|table/#//# + sound_auth_subtitles_speech_list_main04|#",
"max": null
},
{
"id": 17267,
"en": "You've raised a good crew.",
"ctx": "sound_auth|table/#//# + sound_auth_subtitles_speech_list_main04|#",
"max": null
},
{
"id": 17268,
"en": "Heh, right.",
"ctx": "sound_auth|table/#//# + sound_auth_subtitles_speech_list_main04|# + sound_auth_subtitles_speech_list_sub_b18|#",
"max": null
},
{
"id": 17269,
"en": "Nagumo told me about how you two met.",
"ctx": "sound_auth|table/#//# + sound_auth_subtitles_speech_list_main04|#",
"max": null
},
{
"id": 17270,
"en": "Y'really saved his skin back there.",
"ctx": "sound_auth|table/#//# + sound_auth_subtitles_speech_list_main04|#",
"max": null
},
{
"id": 17271,
"en": "Though 'cause of that, things're iffy\nwith the Masuzoe Family now.",
"ctx": "sound_auth|table/#//# + sound_auth_subtitles_speech_list_main04|#",
"max": null
},
{
"id": 17272,
"en": "You know they're lookin' into you now?",
"ctx": "sound_auth|table/#//# + sound_auth_subtitles_speech_list_main04|#",
"max": null
},
{
"id": 17273,
"en": "Are they?",
"ctx": "sound_auth|table/#//# + sound_auth_subtitles_speech_list_main04|#",
"max": null
},
{
"id": 17274,
"en": "I'm just a regular civilian, though.",
"ctx": "sound_auth|table/#//# + sound_auth_subtitles_speech_list_main04|#",
"max": null
},
{
"id": 17275,
"en": "I'll try not to make any more\ntrouble for your family.",
"ctx": "sound_auth|table/#//# + sound_auth_subtitles_speech_list_main04|#",
"max": null
},
{
"id": 17276,
"en": "Nagumo invited you in to make up\nfor how he treated you before.",
"ctx": "sound_auth|table/#//# + sound_auth_subtitles_speech_list_main04|#",
"max": null
},
{
"id": 17277,
"en": "I think he's ready to deal with\nwhatever consequences that brings.",
"ctx": "sound_auth|table/#//# + sound_auth_subtitles_speech_list_main04|#",
"max": null
},
{
"id": 17278,
"en": "Y'like sitting on grandpa's lap, huh?",
"ctx": "sound_auth|table/#//# + sound_auth_subtitles_speech_list_main04|#",
"max": null
},
{
"id": 17279,
"en": "Sorry about him.",
"ctx": "sound_auth|table/#//# + sound_auth_subtitles_speech_list_main04|#",
"max": null
},
{
"id": 17280,
"en": "Here, go on back to yer pa.",
"ctx": "sound_auth|table/#//# + sound_auth_subtitles_speech_list_main04|#",
"max": null
},
{
"id": 17281,
"en": "Well, I should be going now.",
"ctx": "sound_auth|table/#//# + sound_auth_subtitles_speech_list_main04|#",
"max": null
},
{
"id": 17282,
"en": "Already? Come back soon then.",
"ctx": "sound_auth|table/#//# + sound_auth_subtitles_speech_list_main04|#",
"max": null
},
{
"id": 17283,
"en": "I've done nothing but sit around\nsince getting out of the hospital.",
"ctx": "sound_auth|table/#//# + sound_auth_subtitles_speech_list_main04|#",
"max": null
},
{
"id": 17284,
"en": "Livin' off insurance is boring.",
"ctx": "sound_auth|table/#//# + sound_auth_subtitles_speech_list_main04|#",
"max": null
},
{
"id": 17285,
"en": "I'll stop by some other time, then.\nGoodbye then, Patriarch.",
"ctx": "sound_auth|table/#//# + sound_auth_subtitles_speech_list_main04|#",
"max": null
},
{
"id": 17286,
"en": "Aniki, y'leavin' already?",
"ctx": "sound_auth|table/#//# + sound_auth_subtitles_speech_list_main04|#",
"max": null
},
{
"id": 17287,
"en": "I am. Thanks for having me over.",
"ctx": "sound_auth|table/#//# + sound_auth_subtitles_speech_list_main04|#",
"max": null
},
{
"id": 17288,
"en": "Are y'gonna keep lookin'\nfer the kid's dad?",
"ctx": "sound_auth|table/#//# + sound_auth_subtitles_speech_list_main04|#",
"max": null
},
{
"id": 17289,
"en": "You can forget about that now.",
"ctx": "sound_auth|table/#//# + sound_auth_subtitles_speech_list_main04|#",
"max": null
},
{
"id": 17290,
"en": "Huh? And, uh...\nWhy's that?",
"ctx": "sound_auth|table/#//# + sound_auth_subtitles_speech_list_main04|#",
"max": null
},
{
"id": 17291,
"en": "Don't worry.\nSee you later.",
"ctx": "sound_auth|table/#//# + sound_auth_subtitles_speech_list_main04|#",
"max": null
},
{
"id": 17292,
"en": "Oh, Kiryu-san!\nThere you are.",
"ctx": "sound_auth|table/#//# + sound_auth_subtitles_speech_list_main04|#",
"max": null
},
{
"id": 17293,
"en": "Those Masuzoe Family guys from\nlast night were just over by my bar.",
"ctx": "sound_auth|table/#//# + sound_auth_subtitles_speech_list_main04|#",
"max": null
},
{
"id": 17294,
"en": "They said they're looking\nfor you, Kiryu-san.",
"ctx": "sound_auth|table/#//# + sound_auth_subtitles_speech_list_main04|#",
"max": null
},
{
"id": 17295,
"en": "You came all the way here\njust to tell me that?",
"ctx": "sound_auth|table/#//# + sound_auth_subtitles_speech_list_main04|#",
"max": null
},
{
"id": 17296,
"en": "Isn't it important enough?",
"ctx": "sound_auth|table/#//# + sound_auth_subtitles_speech_list_main04|#",
"max": null
},
{
"id": 17297,
"en": "You don't want them picking fights\nwith you when Haruto's around.",
"ctx": "sound_auth|table/#//# + sound_auth_subtitles_speech_list_main04|#",
"max": null
},
{
"id": 17298,
"en": "I guess that's true.",
"ctx": "sound_auth|table/#//# + sound_auth_subtitles_speech_list_main04|#",
"max": null
},
{
"id": 17299,
"en": "If we just stand here though,\nthey'll find us in no time.",
"ctx": "sound_auth|table/#//# + sound_auth_subtitles_speech_list_main04|#",
"max": null
},
{
"id": 17300,
"en": "This way.",
"ctx": "sound_auth|table/#//# + sound_auth_subtitles_speech_list_main04|# + sound_auth_subtitles_speech_list_main07|#",
"max": null
},
{
"id": 17301,
"en": "Let's take the back streets.",
"ctx": "sound_auth|table/#//# + sound_auth_subtitles_speech_list_main04|#",
"max": null
},
{
"id": 17302,
"en": "We can head up to Ryunan Shrine,\na quiet little spot on the hill.",
"ctx": "sound_auth|table/#//# + sound_auth_subtitles_speech_list_main04|#",
"max": null
},
{
"id": 17303,
"en": "Kiryu-san. This way.",
"ctx": "sound_auth|table/#//# + sound_auth_subtitles_speech_list_main04|#",
"max": null
},
{
"id": 17304,
"en": "Hurry up, Kiryu-san.",
"ctx": "sound_auth|table/#//# + sound_auth_subtitles_speech_list_main04|#",
"max": null
},
{
"id": 17305,
"en": "Hold on, Kiryu-san.\nWhere are you going?",
"ctx": "sound_auth|table/#//# + sound_auth_subtitles_speech_list_main04|#",
"max": null
},
{
"id": 17306,
"en": "The Masuzoe Family is going to\nfind you if we don't hurry up!",
"ctx": "sound_auth|table/#//# + sound_auth_subtitles_speech_list_main04|#",
"max": null
},
{
"id": 17307,
"en": "Hey, would y'take a look at that?\nA guy n' his baby!",
"ctx": "sound_auth|table/#//# + sound_auth_subtitles_speech_list_main04|#",
"max": null
},
{
"id": 17308,
"en": "Kiryu-san! Be careful!",
"ctx": "sound_auth|table/#//# + sound_auth_subtitles_speech_list_main04|#",
"max": null
},
{
"id": 17309,
"en": "Don't go playin' dumb with us.",
"ctx": "sound_auth|table/#//# + sound_auth_subtitles_speech_list_main04|#",
"max": null
},
{
"id": 17310,
"en": "Did y'forget what y'did last night?",
"ctx": "sound_auth|table/#//# + sound_auth_subtitles_speech_list_main04|#",
"max": null
},
{
"id": 17311,
"en": "We need t'borrow ya fer a bit.",
"ctx": "sound_auth|table/#//# + sound_auth_subtitles_speech_list_main04|#",
"max": null
},
{
"id": 17312,
"en": "But I guess we should probly\nrough ya up first.",
"ctx": "sound_auth|table/#//# + sound_auth_subtitles_speech_list_main04|#",
"max": null
},
{
"id": 17313,
"en": "Don't go makin' this hard fer yerself.",
"ctx": "sound_auth|table/#//# + sound_auth_subtitles_speech_list_main04|#",
"max": null
},
{
"id": 17314,
"en": "Mama. Can you take Haruto for me?",
"ctx": "sound_auth|table/#//# + sound_auth_subtitles_speech_list_main04|#",
"max": null
},
{
"id": 17315,
"en": "Come on, Haruto-kun.\nOver here.",
"ctx": "sound_auth|table/#//# + sound_auth_subtitles_speech_list_main04|#",
"max": null
},
{
"id": 17316,
"en": "This guy ain't no ordinary grampa.",
"ctx": "sound_auth|table/#//# + sound_auth_subtitles_speech_list_main04|#",
"max": null
},
{
"id": 17317,
"en": "Don't hold anythin' back!",
"ctx": "sound_auth|table/#//# + sound_auth_subtitles_speech_list_main04|#",
"max": null
},
{
"id": 17318,
"en": "Kiryu-san... Are you okay?",
"ctx": "sound_auth|table/#//# + sound_auth_subtitles_speech_list_main04|#",
"max": null
},
{
"id": 17319,
"en": "Yeah.\nHaruto doing okay?",
"ctx": "sound_auth|table/#//# + sound_auth_subtitles_speech_list_main04|#",
"max": null
},
{
"id": 17320,
"en": "Yeah, he's fine.",
"ctx": "sound_auth|table/#//# + sound_auth_subtitles_speech_list_main04|#",
"max": null
},
{
"id": 17321,
"en": "We should keep moving before\nmore of them come.",
"ctx": "sound_auth|table/#//# + sound_auth_subtitles_speech_list_main04|#",
"max": null
},
{
"id": 17322,
"en": "Ryunan Shrine.\nThis is it, huh?",
"ctx": "sound_auth|table/#//# + sound_auth_subtitles_speech_list_main04|#",
"max": null
},
{
"id": 17323,
"en": "Let's rest here for now.\nBut Kiryu-san, this is getting bad.",
"ctx": "sound_auth|table/#//# + sound_auth_subtitles_speech_list_main04|#",
"max": null
},
{
"id": 17324,
"en": "If the Masuzoe Family gets their hands\non you before you find Haruto's dad...",
"ctx": "sound_auth|table/#//# + sound_auth_subtitles_speech_list_main04|#",
"max": null
},
{
"id": 17325,
"en": "Honestly, things haven't looked good\never since I met Nagumo in your bar.",
"ctx": "sound_auth|table/#//# + sound_auth_subtitles_speech_list_main04|#",
"max": null
},
{
"id": 17326,
"en": "But I did figure something out\nfrom talking to the Hirose Family.",
"ctx": "sound_auth|table/#//# + sound_auth_subtitles_speech_list_main04|#",
"max": null
},
{
"id": 17327,
"en": "It's about Haruka.\nShe was definitely here.",
"ctx": "sound_auth|table/#//# + sound_auth_subtitles_speech_list_main04|#",
"max": null
},
{
"id": 17328,
"en": "Huh? What do you mean?",
"ctx": "sound_auth|table/#//# + sound_auth_subtitles_speech_list_main04|#",
"max": null
},
{
"id": 17329,
"en": "(Those guys are probably at Moreno...)",
"ctx": "sound_auth|table/#//# + sound_auth_subtitles_speech_list_main04|#",
"max": null
},
{
"id": 17330,
"en": "Oh, Kiryu-aniki...",
"ctx": "sound_auth|table/#//# + sound_auth_subtitles_speech_list_main04|#",
"max": null
},
{
"id": 17331,
"en": "Um, thank you so much for saving me\nfrom those terrible thugs yesterday!",
"ctx": "sound_auth|table/#//# + sound_auth_subtitles_speech_list_main04|#",
"max": null
},
{
"id": 17332,
"en": "I could really see myself falling\nfor a guy like you, Kiryu-san.",
"ctx": "sound_auth|table/#//# + sound_auth_subtitles_speech_list_main04|#",
"max": null
},
{
"id": 17333,
"en": "R-Right. That's okay...",
"ctx": "sound_auth|table/#//# + sound_auth_subtitles_speech_list_main04|#",
"max": null
},
{
"id": 17334,
"en": "Can't y'see he ain't interested?",
"ctx": "sound_auth|table/#//# + sound_auth_subtitles_speech_list_main04|#",
"max": null
},
{
"id": 17335,
"en": "What's yer problem?",
"ctx": "sound_auth|table/#//# + sound_auth_subtitles_speech_list_main04|#",
"max": null
},
{
"id": 17336,
"en": "If Matsunaga-aniki wants customers,\nhe oughta look for a hotter girl.",
"ctx": "sound_auth|table/#//# + sound_auth_subtitles_speech_list_main04|#",
"max": null
},
{
"id": 17337,
"en": "Fer some reason,\nhe likes 'em butch.",
"ctx": "sound_auth|table/#//# + sound_auth_subtitles_speech_list_main04|#",
"max": null
},
{
"id": 17338,
"en": "With our one hostess lookin' like that,\nthe place'll stay a ghost town.",
"ctx": "sound_auth|table/#//# + sound_auth_subtitles_speech_list_main04|#",
"max": null
},
{
"id": 17339,
"en": "And where's Matsunaga now?",
"ctx": "sound_auth|table/#//# + sound_auth_subtitles_speech_list_main04|#",
"max": null
},
{
"id": 17340,
"en": "Jus' back there.\nGo ahead.",
"ctx": "sound_auth|table/#//# + sound_auth_subtitles_speech_list_main04|#",
"max": null
},
{
"id": 17341,
"en": "Yamato... The biggest\nbattleship ever built.",
"ctx": "sound_auth|table/#//# + sound_auth_subtitles_speech_list_main04|#",
"max": null
},
{
"id": 17342,
"en": "It's a national treasure\nbuilt right here in Hiroshima.",
"ctx": "sound_auth|table/#//# + sound_auth_subtitles_speech_list_main04|#",
"max": null
},
{
"id": 17343,
"en": "Looks almost done.",
"ctx": "sound_auth|table/#//# + sound_auth_subtitles_speech_list_main04|#",
"max": null
},
{
"id": 17344,
"en": "I didn't realize you were\ninterested in these.",
"ctx": "sound_auth|table/#//# + sound_auth_subtitles_speech_list_main04|#",
"max": null
},
{
"id": 17345,
"en": "I was born in a shipbuildin' town. Every\nman, young or old, loves all sorts o' ships.",
"ctx": "sound_auth|table/#//# + sound_auth_subtitles_speech_list_main04|#",
"max": null
},
{
"id": 17346,
"en": "I'm sorry for all the trouble\nI caused in here last night, Matsunaga.",
"ctx": "sound_auth|table/#//# + sound_auth_subtitles_speech_list_main04|#",
"max": null
},
{
"id": 17347,
"en": "Y'were just tryin' to help, right?",
"ctx": "sound_auth|table/#//# + sound_auth_subtitles_speech_list_main04|#",
"max": null
},
{
"id": 17348,
"en": "There's nothing to apologize about.\nDon't even sweat it.",
"ctx": "sound_auth|table/#//# + sound_auth_subtitles_speech_list_main04|#",
"max": null
},
{
"id": 17349,
"en": "But remember, I ain't your friend.\nNot yet.",
"ctx": "sound_auth|table/#//# + sound_auth_subtitles_speech_list_main04|#",
"max": null
},
{
"id": 17350,
"en": "I guess I'm a harder nut to\ncrack than Captain Nagumo.",
"ctx": "sound_auth|table/#//# + sound_auth_subtitles_speech_list_main04|#",
"max": null
},
{
"id": 17351,
"en": "Heh, noted.",
"ctx": "sound_auth|table/#//# + sound_auth_subtitles_speech_list_main04|#",
"max": null
},
{
"id": 17352,
"en": "Matsunaga-aniki!",
"ctx": "sound_auth|table/#//# + sound_auth_subtitles_speech_list_main04|#",
"max": null
},
{
"id": 17353,
"en": "Huh? What's up, Yuta?\nSomethin' happen?",
"ctx": "sound_auth|table/#//# + sound_auth_subtitles_speech_list_main04|#",
"max": null
},
{
"id": 17354,
"en": "Y'know those customers from last night?\nThe shipbuilders?",
"ctx": "sound_auth|table/#//# + sound_auth_subtitles_speech_list_main04|#",
"max": null
},
{
"id": 17355,
"en": "Yeah. What about 'em?",
"ctx": "sound_auth|table/#//# + sound_auth_subtitles_speech_list_main04|#",
"max": null
},
{
"id": 17356,
"en": "Apparently they hightailed it to the Yomei\nAlliance to tattle on us.",
"ctx": "sound_auth|table/#//# + sound_auth_subtitles_speech_list_main04|#",
"max": null
},
{
"id": 17357,
"en": "The main family captain's over\nat our office now to settle things.",
"ctx": "sound_auth|table/#//# + sound_auth_subtitles_speech_list_main04|#",
"max": null
},
{
"id": 17358,
"en": "Wait, their captain?\nShit, that's Koshimizu-san!",
"ctx": "sound_auth|table/#//# + sound_auth_subtitles_speech_list_main04|#",
"max": null
},
{
"id": 17359,
"en": "He's not alone. Masuzoe's along too,\nfresh off his bruises from the cap.",
"ctx": "sound_auth|table/#//# + sound_auth_subtitles_speech_list_main04|#",
"max": null
},
{
"id": 17360,
"en": "I'd say they're like, 20 guys deep.",
"ctx": "sound_auth|table/#//# + sound_auth_subtitles_speech_list_main04|#",
"max": null
},
{
"id": 17361,
"en": "Twenty guys? All at our place?",
"ctx": "sound_auth|table/#//# + sound_auth_subtitles_speech_list_main04|#",
"max": null
},
{
"id": 17362,
"en": "Captain Nagumo said t'come\nget you, Matsunaga-aniki.",
"ctx": "sound_auth|table/#//# + sound_auth_subtitles_speech_list_main04|#",
"max": null
},
{
"id": 17363,
"en": "I'm probly gonna have t'chop off\na pinky over this nonsense.",
"ctx": "sound_auth|table/#//# + sound_auth_subtitles_speech_list_main04|#",
"max": null
},
{
"id": 17364,
"en": "But why you, Matsunaga-aniki?",
"ctx": "sound_auth|table/#//# + sound_auth_subtitles_speech_list_main04|#",
"max": null
},
{
"id": 17365,
"en": "Y'weren't the one beatin'\non the customers last night.",
"ctx": "sound_auth|table/#//# + sound_auth_subtitles_speech_list_main04|#",
"max": null
},
{
"id": 17366,
"en": "Don't be dumb.\nIt's a Hirose bar, and I run it.",
"ctx": "sound_auth|table/#//# + sound_auth_subtitles_speech_list_main04|#",
"max": null
},
{
"id": 17367,
"en": "I've gotta take responsibility,\neven fer a fight between customers.",
"ctx": "sound_auth|table/#//# + sound_auth_subtitles_speech_list_main04|#",
"max": null
},
{
"id": 17368,
"en": "I can't pin it all on Kiryu-san.",
"ctx": "sound_auth|table/#//# + sound_auth_subtitles_speech_list_main04|#",
"max": null
},
{
"id": 17369,
"en": "But y'know... Kiryu-san ain't\nfrom around here, right?",
"ctx": "sound_auth|table/#//# + sound_auth_subtitles_speech_list_main04|#",
"max": null
},
{
"id": 17370,
"en": "If we get him to apologize to 'em...",
"ctx": "sound_auth|table/#//# + sound_auth_subtitles_speech_list_main04|#",
"max": null
},
{
"id": 17371,
"en": "Y'think I'm gonna do somethin'\nthat pathetic? Huh!?",
"ctx": "sound_auth|table/#//# + sound_auth_subtitles_speech_list_main04|#",
"max": null
},
{
"id": 17372,
"en": "I know we're chumps for yakuza n' all,\nbut I ain't gonna sell Hirose short.",
"ctx": "sound_auth|table/#//# + sound_auth_subtitles_speech_list_main04|#",
"max": null
},
{
"id": 17373,
"en": "Hold on. I have a question first.",
"ctx": "sound_auth|table/#//# + sound_auth_subtitles_speech_list_main04|#",
"max": null
},
{
"id": 17374,
"en": "How is a drunken brawl enough to bring their\ncaptain to a small family office like yours?",
"ctx": "sound_auth|table/#//# + sound_auth_subtitles_speech_list_main04|#",
"max": null
},
{
"id": 17375,
"en": "An outsider would never understand.",
"ctx": "sound_auth|table/#//# + sound_auth_subtitles_speech_list_main04|#",
"max": null
},
{
"id": 17376,
"en": "This town's the home base\nfor Iwami Shipbuilding.",
"ctx": "sound_auth|table/#//# + sound_auth_subtitles_speech_list_main04|#",
"max": null
},
{
"id": 17377,
"en": "Iwami Shipbuilding?",
"ctx": "sound_auth|table/#//# + sound_auth_subtitles_speech_list_main04|#",
"max": null
},
{
"id": 17378,
"en": "It's where some o' the drunks\nfrom last night work.",
"ctx": "sound_auth|table/#//# + sound_auth_subtitles_speech_list_main04|#",
"max": null
},
{
"id": 17379,
"en": "Iwami's one o' the biggest shipbuildin'\nbusinesses the world over.",
"ctx": "sound_auth|table/#//# + sound_auth_subtitles_speech_list_main04|#",
"max": null
},
{
"id": 17380,
"en": "They got tonsa influence, 'specially\n'round here. Schools, hospitals, y'name it.",
"ctx": "sound_auth|table/#//# + sound_auth_subtitles_speech_list_main04|#",
"max": null
},
{
"id": 17381,
"en": "Everyone in Hiroshima's connected\nto Iwami one way or another.",
"ctx": "sound_auth|table/#//# + sound_auth_subtitles_speech_list_main04|#",
"max": null
},
{
"id": 17382,
"en": "Anybody who dares to rise up at 'em,\nyer life in Hiroshima may as well be over.",
"ctx": "sound_auth|table/#//# + sound_auth_subtitles_speech_list_main04|#",
"max": null
},
{
"id": 17383,
"en": "And even the Yomei Alliance bows to them?",
"ctx": "sound_auth|table/#//# + sound_auth_subtitles_speech_list_main04|#",
"max": null
},
{
"id": 17384,
"en": "That's enough talk.\nThis don't concern ya, Kiryu-san.",
"ctx": "sound_auth|table/#//# + sound_auth_subtitles_speech_list_main04|#",
"max": null
},
{
"id": 17385,
"en": "Jus' act like y'never heard\nany o' this. Now then...",
"ctx": "sound_auth|table/#//# + sound_auth_subtitles_speech_list_main04|#",
"max": null
},
{
"id": 17386,
"en": "Matsunaga, don't pretend like you can\nhandle this alone. I'm going with you.",
"ctx": "sound_auth|table/#//# + sound_auth_subtitles_speech_list_main04|#",
"max": null
},
{
"id": 17387,
"en": "Yuta. Tagashira.\nDon't let Kiryu-san leave this bar.",
"ctx": "sound_auth|table/#//# + sound_auth_subtitles_speech_list_main04|#",
"max": null
},
{
"id": 17388,
"en": "What? But...",
"ctx": "sound_auth|table/#//# + sound_auth_subtitles_speech_list_main04|#",
"max": null
},
{
"id": 17389,
"en": "That's an order from yer aniki.\nDon't make me repeat m'self.",
"ctx": "sound_auth|table/#//# + sound_auth_subtitles_speech_list_main04|#",
"max": null
},
{
"id": 17390,
"en": "These're Matsunaga-aniki's orders, Kiryu-san.\nJus' stay here and cool off fer a bit.",
"ctx": "sound_auth|table/#//# + sound_auth_subtitles_speech_list_main04|#",
"max": null
},
{
"id": 17391,
"en": "Please. You need to stop sticking\nyer nose where it doesn't belong.",
"ctx": "sound_auth|table/#//# + sound_auth_subtitles_speech_list_main04|#",
"max": null
},
{
"id": 17392,
"en": "Looks like we really can't\ncall you our aniki.",
"ctx": "sound_auth|table/#//# + sound_auth_subtitles_speech_list_main04|#",
"max": null
},
{
"id": 17393,
"en": "We're not quite like Captain Nagumo.",
"ctx": "sound_auth|table/#//# + sound_auth_subtitles_speech_list_main04|#",
"max": null
},
{
"id": 17394,
"en": "I understand the point you're trying\nto prove, but you need to step aside.",
"ctx": "sound_auth|table/#//# + sound_auth_subtitles_speech_list_main04|#",
"max": null
},
{
"id": 17395,
"en": "Are y'trying to shame Matsunaga-aniki?",
"ctx": "sound_auth|table/#//# + sound_auth_subtitles_speech_list_main04|#",
"max": null
},
{
"id": 17396,
"en": "I started the fight last night.",
"ctx": "sound_auth|table/#//# + sound_auth_subtitles_speech_list_main04|#",
"max": null
},
{
"id": 17397,
"en": "If anything, you're the ones\nwho should be staying out of this.",
"ctx": "sound_auth|table/#//# + sound_auth_subtitles_speech_list_main04|#",
"max": null
},
{
"id": 17398,
"en": "All you two did was sit around and\nget your punk asses beaten.",
"ctx": "sound_auth|table/#//# + sound_auth_subtitles_speech_list_main04|#",
"max": null
},
{
"id": 17399,
"en": "What was that!?",
"ctx": "sound_auth|table/#//# + sound_auth_subtitles_speech_list_main04|#",
"max": null
},
{
"id": 17400,
"en": "If I don't hurry, Matsunaga's done!",
"ctx": "sound_auth|table/#//# + sound_auth_subtitles_speech_list_main04|#",
"max": null
},
{
"id": 17401,
"en": "You think you scare us!?\nBring it, old man!",
"ctx": "sound_auth|table/#//# + sound_auth_subtitles_speech_list_main04|#",
"max": null
},
{
"id": 17402,
"en": "Don't take this personally.",
"ctx": "sound_auth|table/#//# + sound_auth_subtitles_speech_list_main04|#",
"max": null
},
{
"id": 17403,
"en": "W-Wait! Please, stop!",
"ctx": "sound_auth|table/#//# + sound_auth_subtitles_speech_list_main04|#",
"max": null
},
{
"id": 17404,
"en": "You're all alone. How do ya\nthink you're gonna settle this?",
"ctx": "sound_auth|table/#//# + sound_auth_subtitles_speech_list_main04|#",
"max": null
},
{
"id": 17405,
"en": "You gonna offer up your pinky\nin Matsunaga-aniki's place?",
"ctx": "sound_auth|table/#//# + sound_auth_subtitles_speech_list_main04|#",
"max": null
},
{
"id": 17406,
"en": "I just want to talk to these Yomei guys.\nHow they respond is up to them.",
"ctx": "sound_auth|table/#//# + sound_auth_subtitles_speech_list_main04|#",
"max": null
},
{
"id": 17407,
"en": "Y'don't understand. They control\nevery last yakuza in Hiroshima.",
"ctx": "sound_auth|table/#//# + sound_auth_subtitles_speech_list_main04|#",
"max": null
},
{
"id": 17408,
"en": "Y'can't just go in swinging!\nDo you hear a word I'm saying!?",
"ctx": "sound_auth|table/#//# + sound_auth_subtitles_speech_list_main04|#",
"max": null
},
{
"id": 17409,
"en": "Sides, we jus' met ya!",
"ctx": "sound_auth|table/#//# + sound_auth_subtitles_speech_list_main04|#",
"max": null
},
{
"id": 17410,
"en": "And yer still tryin' to risk\nyer life to save Matsunaga-aniki?",
"ctx": "sound_auth|table/#//# + sound_auth_subtitles_speech_list_main04|#",
"max": null
},
{
"id": 17411,
"en": "Why're y'doin' this!?",
"ctx": "sound_auth|table/#//# + sound_auth_subtitles_speech_list_main04|#",
"max": null
},
{
"id": 17412,
"en": "You guys knew Haruka.\nAnd I know you're hiding it from me.",
"ctx": "sound_auth|table/#//# + sound_auth_subtitles_speech_list_main04|#",
"max": null
},
{
"id": 17413,
"en": "Wh-Where's this comin' from...?",
"ctx": "sound_auth|table/#//# + sound_auth_subtitles_speech_list_main04|#",
"max": null
},
{
"id": 17414,
"en": "The more I help you, the more willing\nyou'll be to tell me what I want.",
"ctx": "sound_auth|table/#//# + sound_auth_subtitles_speech_list_main04|#",
"max": null
},
{
"id": 17415,
"en": "I've got my own motives for doing this.\nAnd charity isn't one of them.",
"ctx": "sound_auth|table/#//# + sound_auth_subtitles_speech_list_main04|#",
"max": null
},
{
"id": 17416,
"en": "Yeah, right.",
"ctx": "sound_auth|table/#//# + sound_auth_subtitles_speech_list_main04|#",
"max": null
},
{
"id": 17417,
"en": "If info's all you wanted, you could've\njust beat on us 'til we talked.",
"ctx": "sound_auth|table/#//# + sound_auth_subtitles_speech_list_main04|#",
"max": null
},
{
"id": 17418,
"en": "Interesting. I never thought of that.",
"ctx": "sound_auth|table/#//# + sound_auth_subtitles_speech_list_main04|#",
"max": null
},
{
"id": 17419,
"en": "Wh-What's that s'posed t'mean...?",
"ctx": "sound_auth|table/#//# + sound_auth_subtitles_speech_list_main04|#",
"max": null
},
{
"id": 17420,
"en": "Seriously... What's the deal with him?",
"ctx": "sound_auth|table/#//# + sound_auth_subtitles_speech_list_main04|#",
"max": null
},
{
"id": 17421,
"en": "(Matsunaga should be at the Hirose office.\nI need to get there, and fast...)",
"ctx": "sound_auth|table/#//# + sound_auth_subtitles_speech_list_main04|#",
"max": null
},
{
"id": 17422,
"en": "Y'finally showed up.\nBeen lookin' fer ya... Kiryu.",
"ctx": "sound_auth|table/#//# + sound_auth_subtitles_speech_list_main04|#",
"max": null
},
{
"id": 17423,
"en": "I owe ya one fer last night.",
"ctx": "sound_auth|table/#//# + sound_auth_subtitles_speech_list_main04|#",
"max": null
},
{
"id": 17424,
"en": "But first, who in the hell are ya?\nWhat brought ya crawlin' into town?",
"ctx": "sound_auth|table/#//# + sound_auth_subtitles_speech_list_main04|#",
"max": null
},
{
"id": 17425,
"en": "My business here isn't with you.",
"ctx": "sound_auth|table/#//# + sound_auth_subtitles_speech_list_main04|#",
"max": null
},
{
"id": 17426,
"en": "I heard there's a Yomei captain here.\nHe's the one I want, so get out of my way.",
"ctx": "sound_auth|table/#//# + sound_auth_subtitles_speech_list_main04|#",
"max": null
}
]