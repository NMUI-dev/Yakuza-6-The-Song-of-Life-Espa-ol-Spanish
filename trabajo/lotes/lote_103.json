"max": null
},
{
"id": 25205,
"en": "There wasn't anywhere better.\nYou know how rural Onomichi is.",
"ctx": "sound_auth|table/#//# + sound_auth_subtitles_speech_list_sub_b06|#",
"max": null
},
{
"id": 25206,
"en": "Well, step right in!",
"ctx": "sound_auth|table/#//# + sound_auth_subtitles_speech_list_sub_b06|#",
"max": null
},
{
"id": 25207,
"en": "Kiryu-san, please!\nBe Michio-kun for our concert!",
"ctx": "sound_auth|table/#//# + sound_auth_subtitles_speech_list_sub_b06|#",
