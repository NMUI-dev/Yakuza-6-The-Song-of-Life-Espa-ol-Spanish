"max": null
},
{
"id": 11170,
"en": "What do you say?\nThis man can be our witness.",
"ctx": "auth|cinema_telop/#//#",
"max": null
},
{
"id": 11171,
"en": "Do you accept?",
"ctx": "auth|cinema_telop/#//#",
"max": null
},
{
"id": 11172,
"en": "Hey, that's enough!",
"ctx": "auth|cinema_telop/#//#",
"max": null
},
{
"id": 11173,
"en": "Don't you get it!? If you do this,\nyou'll never see Haruka or Haruto again!",
"ctx": "auth|cinema_telop/#//#",
"max": null
},
