[
{
"id": 10942,
"en": "They all fell by his hand.",
"ctx": "auth|cinema_telop/#//#",
"max": null
},
{
"id": 10943,
"en": "The secret of Onomichi was safe.",
"ctx": "auth|cinema_telop/#//#",
"max": null
},
{
"id": 10944,
"en": "Protected by the deaths of\nmy subordinates... and my friends.",
"ctx": "auth|cinema_telop/#//#",
"max": null
},
{
"id": 10945,
"en": "I hope you understand what you've done.",
"ctx": "auth|cinema_telop/#//#",
"max": null
},
{
"id": 10946,
"en": "You have rendered their deaths meaningless.",
"ctx": "auth|cinema_telop/#//#",
"max": null
},
{
"id": 10947,
"en": "And for this heinous crime...",
"ctx": "auth|cinema_telop/#//#",
"max": null
},
{
"id": 10948,
"en": "...You too must die.",
"ctx": "auth|cinema_telop/#//#",
"max": null
},
{
"id": 10949,
"en": "Whaddya think yer doin', boss?",
"ctx": "auth|cinema_telop/#//#",
"max": null
},
{
"id": 10950,
"en": "Finish it, Hirose.",
"ctx": "auth|cinema_telop/#//#",
"max": null
},
{
"id": 10951,
"en": "You must kill each and every one of them.",
"ctx": "auth|cinema_telop/#//#",
"max": null
},
{
"id": 10952,
"en": "Leave not a single soul in this world.",
"ctx": "auth|cinema_telop/#//#",
"max": null
},
{
"id": 10953,
"en": "Y'can't do this.",
"ctx": "auth|cinema_telop/#//#",
"max": null
},
{
"id": 10954,
"en": "Why do you hesitate?",
"ctx": "auth|cinema_telop/#//#",
"max": null
},
{
"id": 10955,
"en": "I can't do it, Boss!",
"ctx": "auth|cinema_telop/#//#",
"max": null
},
{
"id": 10956,
"en": "Look!",
"ctx": "auth|cinema_telop/#//#",
"max": null
},
{
"id": 10957,
"en": "Nagumo's...",
"ctx": "auth|cinema_telop/#//#",
"max": null
},
{
"id": 10958,
"en": "Hey, you don't have to die.",
"ctx": "auth|cinema_telop/#//#",
"max": null
},
{
"id": 10959,
"en": "You probably don't get all\nthis secret business anyway.",
"ctx": "auth|cinema_telop/#//#",
"max": null
},
{
"id": 10960,
"en": "Just step aside, okay?",
"ctx": "auth|cinema_telop/#//#",
"max": null
},
{
"id": 10961,
"en": "Can you at least lemme spare<symbol=em_dash_with_outline>",
"ctx": "auth|cinema_telop/#//#",
"max": null
},
{
"id": 10962,
"en": "Compromise is unacceptable.",
"ctx": "auth|cinema_telop/#//#",
"max": null
},
{
"id": 10963,
"en": "There is another thing\nI've never told you.",
"ctx": "auth|cinema_telop/#//#",
"max": null
},
{
"id": 10964,
"en": "It concerns the order Daidoji gave me.",
"ctx": "auth|cinema_telop/#//#",
"max": null
},
{
"id": 10965,
"en": "What he really wanted for the battleship...",
"ctx": "auth|cinema_telop/#//#",
"max": null
},
{
"id": 10966,
"en": "...Was its destruction.",
"ctx": "auth|cinema_telop/#//#",
"max": null
},
{
"id": 10967,
"en": "He never suggested that I murder\nthe others who knew about the secret.",
"ctx": "auth|cinema_telop/#//#",
"max": null
},
{
"id": 10968,
"en": "I did.",
"ctx": "auth|cinema_telop/#//#",
"max": null
},
{
"id": 10969,
"en": "What the hell!?",
"ctx": "auth|cinema_telop/#//# + sound_auth|table/#//# + sound_auth_subtitles_speech_list_main01|# …",
"max": null
},
{
"id": 10970,
"en": "Without the battleship,\nI would have lost my leverage over Daidoji.",
"ctx": "auth|cinema_telop/#//#",
"max": null
},
{
"id": 10971,
"en": "Let him go.",
"ctx": "auth|cinema_telop/#//#",
"max": null
},
{
"id": 10972,
"en": "He's already a dead man walking.",
"ctx": "auth|cinema_telop/#//#",
"max": null
},
{
"id": 10973,
"en": "Wow... It's incredible.",
"ctx": "auth|cinema_telop/#//#",
"max": null
},
{
"id": 10974,
"en": "Y'know...",
"ctx": "auth|cinema_telop/#//#",
"max": null
},
{
"id": 10975,
"en": "I always wondered what\nthe secret of Onomichi was.",
"ctx": "auth|cinema_telop/#//#",
"max": null
},
{
"id": 10976,
"en": "I'm glad I got t'see it before I die.",
"ctx": "auth|cinema_telop/#//#",
"max": null
},
{
"id": 10977,
"en": "Thanks for that, boys.",
"ctx": "auth|cinema_telop/#//#",
"max": null
},
{
"id": 10978,
"en": "Nagumo?",
"ctx": "auth|cinema_telop/#//#",
"max": null
},
{
"id": 10979,
"en": "Wh-What is it?",
"ctx": "auth|cinema_telop/#//#",
"max": null
},
{
"id": 10980,
"en": "Truth is, I was hopin' you guys\nwould be the ones t'kill me.",
"ctx": "auth|cinema_telop/#//#",
"max": null
},
{
"id": 10981,
"en": "If y'remember, yer dads were my aniki.",
"ctx": "auth|cinema_telop/#//#",
"max": null
},
{
"id": 10982,
"en": "We know that!",
"ctx": "auth|cinema_telop/#//#",
"max": null
},
{
"id": 10983,
"en": "That's why y'took us in!",
"ctx": "auth|cinema_telop/#//#",
"max": null
},
{
"id": 10984,
"en": "Not really...",
"ctx": "auth|cinema_telop/#//#",
"max": null
},
{
"id": 10985,
"en": "I had to do it.",
"ctx": "auth|cinema_telop/#//#",
"max": null
},
{
"id": 10986,
"en": "I had to...",
"ctx": "auth|cinema_telop/#//#",
"max": null
},
{
"id": 10987,
"en": "N-No way...",
"ctx": "auth|cinema_telop/#//# + sound_auth|table/#//# + sound_auth_subtitles_speech_list_main09|# …",
"max": null
},
{
"id": 10988,
"en": "Boss, you...",
"ctx": "auth|cinema_telop/#//#",
"max": null
},
{
"id": 10989,
"en": "You killed our dads...?",
"ctx": "auth|cinema_telop/#//#",
"max": null
},
{
"id": 10990,
"en": "I'm... sorry.",
"ctx": "auth|cinema_telop/#//#",
"max": null
},
{
"id": 10991,
"en": "Hirose-san!!!",
"ctx": "auth|cinema_telop/#//#",
"max": null
},
{
"id": 10992,
"en": "They knew the secret of Onomichi.",
"ctx": "auth|cinema_telop/#//#",
"max": null
},
{
"id": 10993,
"en": "[I doubt he knows the truth about Onomichi.]",
"ctx": "auth|cinema_telop/#//# + sound_auth|table/#//# + sound_auth_subtitles_speech_list_main10|#",
"max": null
},
{
"id": 10994,
"en": "[The secret that town holds\ncan never be revealed.]",
"ctx": "auth|cinema_telop/#//# + sound_auth|table/#//# + sound_auth_subtitles_speech_list_main10|#",
"max": null
},
{
"id": 10995,
"en": "So what exactly did Lo say?",
"ctx": "auth|cinema_telop/#//#",
"max": null
},
{
"id": 10996,
"en": "It was basically this:",
"ctx": "auth|cinema_telop/#//#",
"max": null
},
{
"id": 10997,
"en": "There's a secret hidden in Onomichi\nthat can't be discovered, no matter what.",
"ctx": "auth|cinema_telop/#//#",
"max": null
},
{
"id": 10998,
"en": "What could he be referring to?",
"ctx": "auth|cinema_telop/#//#",
"max": null
},
{
"id": 10999,
"en": "The secret of Onomichi...?",
"ctx": "auth|cinema_telop/#//#",
"max": null
},
{
"id": 11000,
"en": "Out there lies a secret which\nmust never see the light of day.",
"ctx": "auth|cinema_telop/#//#",
"max": null
},
{
"id": 11001,
"en": "To this end, Yuta Usami's failure\nto end Lo is a thorn in our side.",
"ctx": "auth|cinema_telop/#//#",
"max": null
},
{
"id": 11002,
"en": "Lo will attempt to\nreveal the truth.",
"ctx": "auth|cinema_telop/#//#",
"max": null
},
{
"id": 11003,
"en": "70 years ago...",
"ctx": "auth|cinema_telop/#//#",
"max": null
},
{
"id": 11004,
"en": "We really gonna let all that\nwork amount to nothing?",
"ctx": "auth|cinema_telop/#//#",
"max": null
},
{
"id": 11005,
"en": "Protecting the secret of Onomichi has required\nsacrifices from our very own flesh and blood.",
"ctx": "auth|cinema_telop/#//#",
"max": null
},
{
"id": 11006,
"en": "...A new sacrifice must be made\nin order to keep it hidden.",
"ctx": "auth|cinema_telop/#//#",
"max": null
},
{
"id": 11007,
"en": "Can I put my faith in you, Hirose?",
"ctx": "auth|cinema_telop/#//#",
"max": null
},
{
"id": 11008,
"en": "Iwami Shipbuilding,\nat their Onomichi headquarters...",
"ctx": "auth|cinema_telop/#//#",
"max": null
},
{
"id": 11009,
"en": "...today held a funeral for their former\nchairman, Heizo Iwami.",
"ctx": "auth|cinema_telop/#//#",
"max": null
},
{
"id": 11010,
"en": "After the surfacing of the mysterious\nship dubbed the Yamato Mark II...",
"ctx": "auth|cinema_telop/#//#",
"max": null
},
{
"id": 11011,
"en": "...Chairman Iwami unexpectedly committed\nsuicide in his home with a small handgun.",
"ctx": "auth|cinema_telop/#//#",
"max": null
},
{
"id": 11012,
"en": "Yuta-kun?",
"ctx": "auth|cinema_telop/#//#",
"max": null
},
{
"id": 11013,
"en": "At this time of great stress, the world has its eyes on\nthe company's heir, President Tsuneo Iwami.",
"ctx": "auth|cinema_telop/#//#",
"max": null
},
{
"id": 11014,
"en": "Impressive, Dragon of Dojima.",
"ctx": "auth|cinema_telop/#//#",
"max": null
},
{
"id": 11015,
"en": "You've done quite well!",
"ctx": "auth|cinema_telop/#//#",
"max": null
},
{
"id": 11016,
"en": "We've been expecting you.",
"ctx": "auth|cinema_telop/#//#",
"max": null
},
{
"id": 11017,
"en": "You are to be the entertainment for\nthe succession of our second Takeru Kurusu.",
"ctx": "auth|cinema_telop/#//#",
"max": null
},
{
"id": 11018,
"en": "You'll need a third Kurusu soon enough.",
"ctx": "auth|cinema_telop/#//#",
"max": null
},
{
"id": 11019,
"en": "I actually kinda liked that Someya guy.",
"ctx": "auth|cinema_telop/#//#",
"max": null
},
{
"id": 11020,
"en": "That cute little mama, too.",
"ctx": "auth|cinema_telop/#//#",
"max": null
},
{
"id": 11021,
"en": "She looked so pretty before she died.",
"ctx": "auth|cinema_telop/#//#",
"max": null
},
{
"id": 11022,
"en": "Hiroshima is my home turf.\nYou have no hope of winning here.",
"ctx": "auth|cinema_telop/#//#",
"max": null
},
{
"id": 11023,
"en": "Winning doesn't matter anymore.",
"ctx": "auth|cinema_telop/#//#",
"max": null
},
{
"id": 11024,
"en": "All I care about now is ending the two of you.",
"ctx": "auth|cinema_telop/#//#",
"max": null
},
{
"id": 11025,
"en": "That's all I came to do.",
"ctx": "auth|cinema_telop/#//#",
"max": null
},
{
"id": 11026,
"en": "We weren't expectin' t'leave.",
"ctx": "auth|cinema_telop/#//#",
"max": null
},
{
"id": 11027,
"en": "Y'hear!? Y'gonna fight us,\ny'better be ready t'die!",
"ctx": "auth|cinema_telop/#//#",
"max": null
},
{
"id": 11028,
"en": "Shall we put an end to this, Sugai?",
"ctx": "auth|cinema_telop/#//#",
"max": null
},
{
"id": 11029,
"en": "Let's.",
"ctx": "auth|cinema_telop/#//#",
"max": null
},
{
"id": 11030,
"en": "Haruka!",
"ctx": "auth|cinema_telop/#//#",
"max": null
},
{
"id": 11031,
"en": "N' the baby, too?\nTh-The hell's goin' on!?",
"ctx": "auth|cinema_telop/#//#",
"max": null
},
{
"id": 11032,
"en": "Remember Honjo, that Tokyo detective?",
"ctx": "auth|cinema_telop/#//#",
"max": null
},
{
"id": 11033,
"en": "This afternoon, he received a special order,\ndirect from his superiors.",
"ctx": "auth|cinema_telop/#//#",
"max": null
},
{
"id": 11034,
"en": "He was told to monitor Detective Date\nand rescue the girl and her child.",
"ctx": "auth|cinema_telop/#//#",
"max": null
},
{
"id": 11035,
"en": "After all, they were being illegally imprisoned.",
"ctx": "auth|cinema_telop/#//#",
"max": null
},
{
"id": 11036,
"en": "Honjo? What are you doing here?",
"ctx": "auth|cinema_telop/#//#",
"max": null
},
{
"id": 11037,
"en": "How could you do something like this?",
"ctx": "auth|cinema_telop/#//#",
"max": null
},
{
"id": 11038,
"en": "Excuse me?\nWho's giving the order?",
"ctx": "auth|cinema_telop/#//#",
"max": null
},
{
"id": 11039,
"en": "Date-san, why!?",
"ctx": "auth|cinema_telop/#//#",
"max": null
},
{
"id": 11040,
"en": "You've been caught in the act of\nillegal confinement. Don't try to resist.",
"ctx": "auth|cinema_telop/#//#",
"max": null
},
{
"id": 11041,
"en": "You've got it wrong, Honjo!",
"ctx": "auth|cinema_telop/#//#",
"max": null
},
{
"id": 11042,
"en": "This is exactly what the people\nwho are after Haruka want!",
"ctx": "auth|cinema_telop/#//#",
"max": null
},
{
"id": 11043,
"en": "Someone must have paid off the chief!",
"ctx": "auth|cinema_telop/#//#",
"max": null
},
{
"id": 11044,
"en": "I assure you, my orders came through\nthe appropriate channels.",
"ctx": "auth|cinema_telop/#//#",
"max": null
},
{
"id": 11045,
"en": "Take them!",
"ctx": "auth|cinema_telop/#//#",
"max": null
},
{
"id": 11046,
"en": "You bastard!",
"ctx": "auth|cinema_telop/#//# + sound_auth|table/#//# + sound_auth_subtitles_speech_list_cln|#",
"max": null
},
{
"id": 11047,
"en": "If you want the girl and\nher child to leave here alive...",
"ctx": "auth|cinema_telop/#//#",
"max": null
},
{
"id": 11048,
"en": "...Don't move a goddamn muscle!",
"ctx": "auth|cinema_telop/#//#",
"max": null
},
{
"id": 11049,
"en": "I'll kill you!",
"ctx": "auth|cinema_telop/#//#",
"max": null
},
{
"id": 11050,
"en": "Not so fast!",
"ctx": "auth|cinema_telop/#//#",
"max": null
},
{
"id": 11051,
"en": "Fourth Chairman.",
"ctx": "auth|cinema_telop/#//# + sound_auth|table/#//# + sound_auth_subtitles_speech_list_main01|# …",
"max": null
},
{
"id": 11052,
"en": "You've been a thorn in the Tojo Clan\nand the Yomei Alliance for too long!",
"ctx": "auth|cinema_telop/#//#",
"max": null
},
{
"id": 11053,
"en": "What do you take us for!?",
"ctx": "auth|cinema_telop/#//#",
"max": null
},
{
"id": 11054,
"en": "And the sixth chairman...!",
"ctx": "auth|cinema_telop/#//#",
"max": null
},
{
"id": 11055,
"en": "Always...!",
"ctx": "auth|cinema_telop/#//#",
"max": null
},
{
"id": 11056,
"en": "Looking down on me!",
"ctx": "auth|cinema_telop/#//#",
"max": null
},
{
"id": 11057,
"en": "Step aside, Sugai.",
"ctx": "auth|cinema_telop/#//#",
"max": null
},
{
"id": 11058,
"en": "It would take far too long\nfor you to kill him.",
"ctx": "auth|cinema_telop/#//#",
"max": null
},
{
"id": 11059,
"en": "My father never understood my true nature.",
"ctx": "auth|cinema_telop/#//#",
"max": null
},
{
"id": 11060,
"en": "Compared to him, I'm far more ambitious.",
"ctx": "auth|cinema_telop/#//#",
"max": null
},
{
"id": 11061,
"en": "My thirst for power is unquenchable.",
"ctx": "auth|cinema_telop/#//#",
"max": null
},
{
"id": 11062,
"en": "All my life he pushed me toward an honest career,\nbut that only led me to resent him.",
"ctx": "auth|cinema_telop/#//#",
"max": null
},
{
"id": 11063,
"en": "Restricting a child's mobility only\npushes them toward rebellion.",
"ctx": "auth|cinema_telop/#//#",
"max": null
},
{
"id": 11064,
"en": "This is where I belong.",
"ctx": "auth|cinema_telop/#//#",
"max": null
},
{
"id": 11065,
"en": "With the talent I possess, my father\nshould have realized that years ago.",
"ctx": "auth|cinema_telop/#//#",
"max": null
},
{
"id": 11066,
"en": "The legendary yakuza name Takeru Kurusu...",
"ctx": "auth|cinema_telop/#//#",
"max": null
},
{
"id": 11067,
"en": "...is rightfully mine!",
"ctx": "auth|cinema_telop/#//#",
"max": null
},
{
"id": 11068,
"en": "I'll give you ten seconds to stand up.",
"ctx": "auth|cinema_telop/#//#",
"max": null
},
{
"id": 11069,
"en": "The girl is dead if you don't.",
"ctx": "auth|cinema_telop/#//#",
"max": null
},
{
"id": 11070,
"en": "Oh dear.\nStruggling, are we?",
"ctx": "auth|cinema_telop/#//#",
"max": null
},
{
"id": 11071,
"en": "Behind ya, fucker!",
"ctx": "auth|cinema_telop/#//#",
"max": null
},
{
"id": 11072,
"en": "I-Iwami-san!",
"ctx": "auth|cinema_telop/#//#",
"max": null
},
{
"id": 11073,
"en": "Aniki! Cap!",
"ctx": "auth|cinema_telop/#//#",
"max": null
},
{
"id": 11074,
"en": "We'll keep Haruka and Haruto safe!",
"ctx": "auth|cinema_telop/#//#",
"max": null
},
{
"id": 11075,
"en": "Yer gonna get a nice lecture about\ngoin' off on yer own later, though.",
"ctx": "auth|cinema_telop/#//#",
"max": null
},
{
"id": 11076,
"en": "Both o' ya... On yer feet!",
"ctx": "auth|cinema_telop/#//#",
"max": null
},
{
"id": 11077,
"en": "Y'can do it, Aniki!",
"ctx": "auth|cinema_telop/#//#",
"max": null
},
{
"id": 11078,
"en": "Stand up!",
"ctx": "auth|cinema_telop/#//#",
"max": null
},
{
"id": 11079,
"en": "You're supposed to be dead!",
"ctx": "auth|cinema_telop/#//#",
"max": null
},
{
"id": 11080,
"en": "You're about to understand...",
"ctx": "auth|cinema_telop/#//#",
"max": null
},
{
"id": 11081,
"en": "Just who you picked a fight with.",
"ctx": "auth|cinema_telop/#//#",
"max": null
},
{
"id": 11082,
"en": "Don't fuck with me!",
"ctx": "auth|cinema_telop/#//#",
"max": null
},
{
"id": 11083,
"en": "Iwami-san!",
"ctx": "auth|cinema_telop/#//#",
"max": null
},
{
"id": 11084,
"en": "Eyes on me, y'piece of shit!",
"ctx": "auth|cinema_telop/#//#",
"max": null
},
{
"id": 11085,
"en": "There's nothing holding me back.",
"ctx": "auth|cinema_telop/#//#",
"max": null
},
{
"id": 11086,
"en": "If I'm going down...",
"ctx": "auth|cinema_telop/#//#",
"max": null
},
{
"id": 11087,
"en": "...I'm dragging you to hell with me.",
"ctx": "auth|cinema_telop/#//#",
"max": null
},
{
"id": 11088,
"en": "Little baby Iwami.",
"ctx": "auth|cinema_telop/#//#",
"max": null
},
{
"id": 11089,
"en": "How dare you...",
"ctx": "auth|cinema_telop/#//#",
"max": null
},
{
"id": 11090,
"en": "You won't leave here alive.",
"ctx": "auth|cinema_telop/#//#",
"max": null
},
{
"id": 11091,
"en": "This is the end of the line.",
"ctx": "auth|cinema_telop/#//#",
"max": null
},
{
"id": 11092,
"en": "Sky Finance is gonna be making\na comeback just a couple floors up.",
"ctx": "auth|cinema_telop/#//#",
"max": null
},
{
"id": 11093,
"en": "Thought it'd only be right to stop in.",
"ctx": "auth|cinema_telop/#//#",
"max": null
},
{
"id": 11094,
"en": "I heard.",
"ctx": "auth|cinema_telop/#//#",
"max": null
},
{
"id": 11095,
"en": "Congrats on that.",
"ctx": "auth|cinema_telop/#//#",
"max": null
},
{
"id": 11096,
"en": "I've been thinking about Kiryu-san.",
"ctx": "auth|cinema_telop/#//#",
"max": null
},
{
"id": 11097,
"en": "Date-san, you really saw the body?",
"ctx": "auth|cinema_telop/#//#",
"max": null
},
{
"id": 11098,
"en": "Is he really gone?",
"ctx": "auth|cinema_telop/#//#",
"max": null
},
{
"id": 11099,
"en": "Yeah he is.",
"ctx": "auth|cinema_telop/#//#",
"max": null
},
{
"id": 11100,
"en": "C'mon, one more time, huh?",
"ctx": "auth|cinema_telop/#//#",
"max": null
},
{
"id": 11101,
"en": "You can do it.",
"ctx": "auth|cinema_telop/#//#",
"max": null
},
{
"id": 11102,
"en": "Come to us, Haruto!",
"ctx": "auth|cinema_telop/#//#",
"max": null
},
{
"id": 11103,
"en": "You can do it, Haruto!",
"ctx": "auth|cinema_telop/#//#",
"max": null
},
{
"id": 11104,
"en": "Oh!",
"ctx": "auth|cinema_telop/#//# + sound_auth|table/#//# + sound_auth_subtitles_speech_list_main06|# …",
"max": null
},
{
"id": 11105,
"en": "Ohhh!",
"ctx": "auth|cinema_telop/#//#",
"max": null
},
{
"id": 11106,
"en": "You're doing it, Haruto!",
"ctx": "auth|cinema_telop/#//#",
"max": null
},
{
"id": 11107,
"en": "Ahh, so close!",
"ctx": "auth|cinema_telop/#//#",
"max": null
},
{
"id": 11108,
"en": "Only one guy can confirm Kiryu-san's death,\nand that's you.",
"ctx": "auth|cinema_telop/#//#",
"max": null
},
{
"id": 11109,
"en": "Then they cremate the body like they're\n<font_kind=yakuza_italic>trying</font_kind> to be fishy.",
"ctx": "auth|cinema_telop/#//#",
"max": null
},
{
"id": 11110,
"en": "Kiryu has no living relatives.",
"ctx": "auth|cinema_telop/#//#",
"max": null
},
{
"id": 11111,
"en": "There was no reason to keep his body intact.",
"ctx": "auth|cinema_telop/#//#",
"max": null
},
{
"id": 11112,
"en": "I only got to see him because of my connections.",
"ctx": "auth|cinema_telop/#//#",
"max": null
},
{
"id": 11113,
"en": "That the line you're going to feed me every time?",
"ctx": "auth|cinema_telop/#//#",
"max": null
},
{
"id": 11114,
"en": "Someday, once things are a little different...",
"ctx": "auth|cinema_telop/#//#",
"max": null
},
{
"id": 11115,
"en": "...I hope you'll tell me what really happened.",
"ctx": "auth|cinema_telop/#//#",
"max": null
},
{
"id": 11116,
"en": "Are you awake?",
"ctx": "auth|cinema_telop/#//#",
"max": null
},
{
"id": 11117,
"en": "Kazuma Kiryu-kun.",
"ctx": "auth|cinema_telop/#//#",
"max": null
},
{
"id": 11118,
"en": "I have some news.",
"ctx": "auth|cinema_telop/#//#",
"max": null
},
{
"id": 11119,
"en": "I've just heard that Minoru Daidoji-sensei\npassed away in his sleep yesterday.",
"ctx": "auth|cinema_telop/#//#",
"max": null
},
{
"id": 11120,
"en": "So? Who are you?",
"ctx": "auth|cinema_telop/#//#",
"max": null
},
{
"id": 11121,
"en": "I am a politician, mentored in the art of\ngoverning over the years by Daidoji-sensei.",
"ctx": "auth|cinema_telop/#//#",
"max": null
},
{
"id": 11122,
"en": "This Onomichi incident has caused quite a stir.\nIt's been all over the news.",
"ctx": "auth|cinema_telop/#//#",
"max": null
},
{
"id": 11123,
"en": "Right around election season, as well.",
"ctx": "auth|cinema_telop/#//#",
"max": null
},
{
"id": 11124,
"en": "You've given us a massive headache.",
"ctx": "auth|cinema_telop/#//#",
"max": null
},
{
"id": 11125,
"en": "We're putting out fires left and right.",
"ctx": "auth|cinema_telop/#//#",
"max": null
},
{
"id": 11126,
"en": "But I suppose all fires burn out in time.\nWe simply have to wait.",
"ctx": "auth|cinema_telop/#//#",
"max": null
},
{
"id": 11127,
"en": "It's also possible for a small spark to\nerupt into a swirling inferno.",
"ctx": "auth|cinema_telop/#//#",
"max": null
},
{
"id": 11128,
"en": "The Yamato Mark II.\nTakeru Kurusu. Tsuneo Iwami.",
"ctx": "auth|cinema_telop/#//#",
"max": null
},
{
"id": 11129,
"en": "We cannot allow Daidoji-sensei's connections\nto these blights to come out.",
"ctx": "auth|cinema_telop/#//#",
"max": null
},
{
"id": 11130,
"en": "Is that clear?",
"ctx": "auth|cinema_telop/#//#",
"max": null
},
{
"id": 11131,
"en": "If you spoke to the media of this, Daidoji-sensei's\nreputation would be irreparably damaged.",
"ctx": "auth|cinema_telop/#//#",
"max": null
},
{
"id": 11132,
"en": "Beyond that, inquiries would begin into\nthe past actions of anyone involved with him.",
"ctx": "auth|cinema_telop/#//#",
"max": null
},
{
"id": 11133,
"en": "In other words, the politicians steering\nour country would come under fire.",
"ctx": "auth|cinema_telop/#//#",
"max": null
},
{
"id": 11134,
"en": "Do you understand?",
"ctx": "auth|cinema_telop/#//#",
"max": null
},
{
"id": 11135,
"en": "...You're one of those politicians?",
"ctx": "auth|cinema_telop/#//#",
"max": null
},
{
"id": 11136,
"en": "And, this would be hush money.",
"ctx": "auth|cinema_telop/#//#",
"max": null
},
{
"id": 11137,
"en": "I've done a great deal of research on you.",
"ctx": "auth|cinema_telop/#//#",
"max": null
},
{
"id": 11138,
"en": "Do you have a soft spot for orphanages?",
"ctx": "auth|cinema_telop/#//#",
"max": null
},
{
"id": 11139,
"en": "You certainly need money to run one.\nI'm a sympathetic man.",
"ctx": "auth|cinema_telop/#//#",
"max": null
},
{
"id": 11140,
"en": "And I could never threaten a man in a hospital bed.",
"ctx": "auth|cinema_telop/#//#",
"max": null
},
{
"id": 11141,
"en": "All you need to do is accept this money,\nand promise you'll keep our secrets safe.",
"ctx": "auth|cinema_telop/#//#",
"max": null
},
{
"id": 11142,
"en": "That is all we ask.",
"ctx": "auth|cinema_telop/#//#",
"max": null
},
{
"id": 11143,
"en": "Not happening.",
"ctx": "auth|cinema_telop/#//#",
"max": null
},
{
"id": 11144,
"en": "If you want me to keep your secrets...",
"ctx": "auth|cinema_telop/#//#",
"max": null
},
{
"id": 11145,
"en": "...I have conditions.",
"ctx": "auth|cinema_telop/#//#",
"max": null
},
{
"id": 11146,
"en": "E-Excuse me!?",
"ctx": "auth|cinema_telop/#//#",
"max": null
},
{
"id": 11147,
"en": "Do you know who you're talking to!?",
"ctx": "auth|cinema_telop/#//#",
"max": null
},
{
"id": 11148,
"en": "First, I need Daigo Dojima out of prison.",
"ctx": "auth|cinema_telop/#//#",
"max": null
},
{
"id": 11149,
"en": "If he stays locked away, Hiroshima\nwill be overrun by a yakuza war.",
"ctx": "auth|cinema_telop/#//#",
"max": null
},
{
"id": 11150,
"en": "That would be some fire to put out,\nwouldn't it?",
"ctx": "auth|cinema_telop/#//#",
"max": null
},
{
"id": 11151,
"en": "You ingrate! Do you understand\nthe situation you're in right now!?",
"ctx": "auth|cinema_telop/#//#",
"max": null
},
{
"id": 11152,
"en": "If you don't accept my conditions,\nthere's no deal.",
"ctx": "auth|cinema_telop/#//#",
"max": null
},
{
"id": 11153,
"en": "You can live the rest of your life in fear.",
"ctx": "auth|cinema_telop/#//#",
"max": null
},
{
"id": 11154,
"en": "Are all yakuza this stupid?",
"ctx": "auth|cinema_telop/#//#",
"max": null
},
{
"id": 11155,
"en": "You shouldn't take me so lightly.\nDon't you value your life?",
"ctx": "auth|cinema_telop/#//#",
"max": null
},
{
"id": 11156,
"en": "And what about your family? Your friends?\nWho knows how they would end up.",
"ctx": "auth|cinema_telop/#//#",
"max": null
},
{
"id": 11157,
"en": "Try me.",
"ctx": "auth|cinema_telop/#//# + sound_auth|table/#//# + sound_auth_subtitles_speech_list_cln|#",
"max": null
},
{
"id": 11158,
"en": "You say you did the research?",
"ctx": "auth|cinema_telop/#//#",
"max": null
},
{
"id": 11159,
"en": "Then you know what happens\nwhen people hurt my family?",
"ctx": "auth|cinema_telop/#//#",
"max": null
},
{
"id": 11160,
"en": "You want that?",
"ctx": "auth|cinema_telop/#//#",
"max": null
