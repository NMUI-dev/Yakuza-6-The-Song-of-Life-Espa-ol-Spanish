{
"id": 6215,
"en": "Sachiko has been abducted by JUSTIS.\nMobilize the Kiryu Clan to save her!",
"ctx": "clan_creator_mission|explanation",
"max": null
},
{
"id": 6216,
"en": "JUSTIS, now serious about crushing the Kiryu Clan, continues\nits attack on Onomichi. Wipe them out and protect the city.",
"ctx": "clan_creator_mission|explanation",
"max": null
},
{
"id": 6217,
"en": "Yano of the Six Lunatics has finally arrived, and his\nminions have launched their assault. Wipe them\nout and turn the tables!",
"ctx": "clan_creator_mission|explanation",
"max": null
},
{
"id": 6218,
"en": "Yano's underlings have called for reinforcements and\nlaunched an all-out attack. Break through their massive\narmy and take down the enemy commander!",
"ctx": "clan_creator_mission|explanation",
"max": null
},
{
"id": 6219,
"en": "Yano of the Six Lunatics has finally set foot on the\nbattlefield.",
"ctx": "clan_creator_mission|explanation",
"max": null
},
{
"id": 6220,
"en": "Naito begins his assault with his personal entourage.\nThey seem nothing like the Yano Army, so advance\nwith caution!",
"ctx": "clan_creator_mission|explanation",
"max": null
},
{
"id": 6221,
"en": "Naito sets foot on the battlefield, raising the morale of\nthe Naito Army. Defend against their attacks and strike\nback!",
"ctx": "clan_creator_mission|explanation",
"max": null
},
{
"id": 6222,
"en": "Naito of the Six Lunatics is attacking in earnest now. Win\nthis battle against him and drive JUSTIS out of Onomichi.",
"ctx": "clan_creator_mission|explanation",
"max": null
},
{
"id": 6223,
"en": "The Six Lunatics have sent in the deadly tag team of Tenzan\nand Kojima! Tenzan takes the helm first, so take him down!",
"ctx": "clan_creator_mission|explanation",
"max": null
},
{
"id": 6224,
"en": "The Six Lunatics have sent in the deadly tag team of Tenzan\nand Kojima! Kojima's army is up next, so take them out!",
"ctx": "clan_creator_mission|explanation",
"max": null
},
{
"id": 6225,
"en": "Tenzan and Kojima have joined forces in an all-out attack.\nThis will be a power unlike anything you have faced yet,\nso annihilate them without mercy!",
"ctx": "clan_creator_mission|explanation",
"max": null
},
{
"id": 6226,
"en": "Tanahashi of the Six Lunatics has sent out his men. Bring\nthe power of the Kiryu Clan together and wipe them out.",
"ctx": "clan_creator_mission|explanation",
"max": null
},
{
"id": 6227,
"en": "Tanahashi of the Six Lunatics is taking matters into his\nown hands. Defeat him and prevent the invasion!",
"ctx": "clan_creator_mission|explanation",
"max": null
}
]